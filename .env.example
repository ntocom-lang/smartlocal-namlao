# App configuration
VITE_TENANT_SLUG=namlao

# Google Maps Platform API Key
# ⚠️ Do NOT commit actual API keys to git. Use HTTP Referrer Restrictions on GCP Console.

# Longdo Map Key (Tile / Reverse Geocoding fallback)
VITE_LONGDO_KEY=

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ArcGIS Location Platform API key (ไม่บังคับ) — ใส่แล้วภาพดาวเทียมจะใช้ endpoint ที่อยู่ในกรอบ
# ToS ปัจจุบันของ Esri แทน endpoint legacy ถ้าเว้นว่างระบบยังทำงานได้ด้วย fallback อัตโนมัติ
# สมัครฟรีที่ location.arcgis.com — ห้ามเปิด pay-as-you-go เพื่อให้เกินโควตาแล้ว "หยุด" ไม่ใช่ "คิดเงิน"
VITE_ARCGIS_API_KEY=
