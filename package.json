{
  "name": "smartlocal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.js",
    "lint": "eslint .",
    "lint:blocking": "node scripts/lint-blocking.mjs",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "cf:deploy": "node scripts/predeploy-check.js && npm run lint:blocking && npm run build && wrangler deploy && npm run test:smoke -- --expect-local-build",
    "cf:deploy:force": "npm run build && wrangler deploy",
    "check:uniform": "node scripts/check-backend-uniformity.mjs",
    "test:demo-roles": "node tests/negative-authorization.playwright.mjs",
    "test:demo-roles:check": "node tests/negative-authorization.playwright.mjs --check-config",
    "test:workflow": "node tests/complaint-workflow.playwright.mjs",
    "test:workflow:write": "node tests/complaint-workflow.playwright.mjs --write",
    "test:fleet": "node tests/fleet-workflow.playwright.mjs",
    "test:fleet:write": "node tests/fleet-workflow.playwright.mjs --write",
    "test:fleet:cleanup": "node tests/fleet-workflow.playwright.mjs --cleanup",
    "test:odor": "node tests/odor-workflow.playwright.mjs",
    "test:odor:write": "node tests/odor-workflow.playwright.mjs --write",
    "test:local-build": "node tests/verify-local-build.mjs",
    "test:smoke": "node tests/post-deploy-smoke.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@riz007/thai-address-data": "^0.1.4",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "playwright": "^1.61.1",
    "supabase": "^2.116.0",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "wrangler": "^4.127.0"
  }
}
